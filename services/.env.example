# Services-wide environment variables (example)

# MongoDB URIs (use Atlas connection strings in production)
AUTH_MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/auth-user-db?retryWrites=true&w=majority
GAME_MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/game-db?retryWrites=true&w=majority
PURCHASE_MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/purchase-db?retryWrites=true&w=majority
WISHLIST_MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/wishlist-db?retryWrites=true&w=majority
STORAGE_MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/storage-db?retryWrites=true&w=majority

# JWT
JWT_SECRET=your_jwt_secret_here_change_in_prod
JWT_EXPIRATION_SECONDS=604800

# Docker image prefix (e.g. ghcr.io/your-org)
IMAGE_PREFIX=ghcr.io/<org>

# Notes: copy values into each service `.env` or into your Docker Compose environment.