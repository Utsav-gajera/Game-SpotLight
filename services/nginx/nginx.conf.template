user  nginx;
worker_processes  auto;
error_log  /var/log/nginx/error.log warn;
pid        /var/run/nginx.pid;

events { worker_connections 1024; }

http {
  include       mime.types;
  default_type  application/octet-stream;

  sendfile on;
  keepalive_timeout 65;

  # Placeholders will be set inside each server block so DNS resolver and
  # variable assignments are in a valid context during startup.

  server {
    listen 80;
    server_name _;

    # DNS resolver and runtime backend host variables (substituted by
    # `docker-entrypoint.sh` from env vars like @GAME_SERVICE_HOST@).
    resolver 8.8.8.8 ipv6=off;
    set $GAME_SERVICE_HOST "@GAME_SERVICE_HOST@";
    set $PURCHASE_SERVICE_HOST "@PURCHASE_SERVICE_HOST@";
    set $WISHLIST_SERVICE_HOST "@WISHLIST_SERVICE_HOST@";
    set $NOTIFICATION_SERVICE_HOST "@NOTIFICATION_SERVICE_HOST@";
    set $STORAGE_SERVICE_HOST "@STORAGE_SERVICE_HOST@";
    set $AUTH_SERVICE_HOST "@AUTH_SERVICE_HOST@";

    # API routing
    location /api/games/ {
      proxy_pass http://$GAME_SERVICE_HOST;
      proxy_set_header Host $host;
      proxy_set_header X-Real-IP $remote_addr;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /api/purchases/ {
      proxy_pass http://$PURCHASE_SERVICE_HOST;
      proxy_set_header Host $host;
      proxy_set_header X-Real-IP $remote_addr;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /api/wishlist/ {
      proxy_pass http://$WISHLIST_SERVICE_HOST;
      proxy_set_header Host $host;
      proxy_set_header X-Real-IP $remote_addr;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /api/notifications/ {
      proxy_pass http://$NOTIFICATION_SERVICE_HOST;
      proxy_set_header Host $host;
      proxy_set_header X-Real-IP $remote_addr;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /api/storage/ {
      proxy_pass http://$STORAGE_SERVICE_HOST;
      proxy_set_header Host $host;
      proxy_set_header X-Real-IP $remote_addr;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /api/auth/ {
      proxy_pass http://$AUTH_SERVICE_HOST;
      proxy_set_header Host $host;
      proxy_set_header X-Real-IP $remote_addr;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Healthcheck endpoint for Render
    location /_health {
      return 200 'OK';
      add_header Content-Type text/plain;
    }

    # Catch-all for unknown routes
    location / {
      return 404;
    }
  }
}
