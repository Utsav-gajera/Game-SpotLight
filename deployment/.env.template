# .env.template - Copy to .env and fill in your values
# Location: /opt/GameSpotlight/Game-SpotLight/.env
# Source: Used by systemd services via EnvironmentFile

# ============================================================
# PostgreSQL Credentials (Aiven)
# ============================================================
POSTGRES_JDBC_URL=jdbc:postgresql://gamespotlightdb-gajerautsav08-9ccc.h.aivencloud.com:22498/auth_db?sslmode=require
POSTGRES_USER=avnadmin
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD

# ============================================================
# MongoDB URI (Atlas or Aiven)
# ============================================================
MONGO_URI=CHANGE_ME_MONGO_URI

# ============================================================
# JWT Configuration
# ============================================================
JWT_SECRET=CHANGE_ME_JWT_SECRET
JWT_EXPIRATION_SECONDS=604800

# ============================================================
# Kafka (Aiven)
# ============================================================
KAFKA_BOOTSTRAP_SERVERS=gamespotlight-gajerautsav08-9ccc.l.aivencloud.com:22511
KAFKA_SECURITY_PROTOCOL=SASL_SSL
KAFKA_SASL_MECHANISM=PLAIN
KAFKA_API_KEY=avnadmin
KAFKA_API_SECRET=CHANGE_ME_KAFKA_API_SECRET
KAFKA_TRUSTSTORE_LOCATION=/opt/GameSpotlight/Game-SpotLight/aiven-broker-cert.pem

# ============================================================
# Redis (Aiven)
# ============================================================
REDIS_HOST=13.200.236.38
REDIS_PORT=14985
REDIS_USERNAME=default
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
REDIS_SSL=false

# ============================================================
# Supabase (Auth service project)
# ============================================================
AUTH_SUPABASE_URL=https://YOUR_AUTH_SUPABASE_PROJECT.supabase.co
AUTH_SUPABASE_ANON_KEY=YOUR_AUTH_SUPABASE_ANON_KEY

# ============================================================
# Supabase (Storage service project)
# ============================================================
STORAGE_SUPABASE_URL=https://YOUR_STORAGE_SUPABASE_PROJECT.supabase.co
STORAGE_SUPABASE_KEY=YOUR_STORAGE_SUPABASE_SERVICE_ROLE_KEY

# Optional shared aliases for older local setups (leave blank if using service-specific vars)
# SUPABASE_URL=
# SUPABASE_KEY=
# SUPABASE_ANON_KEY=
SUPABASE_BUCKET_GAME_FILES=game-files
SUPABASE_BUCKET_GAME_IMAGES=game-images

# ============================================================
# Email (Brevo SMTP) - Free tier: 300 emails/day
# ============================================================
BREVO_SMTP_USERNAME=CHANGE_ME_SMTP_USERNAME
BREVO_SMTP_PASSWORD=CHANGE_ME_SMTP_PASSWORD
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
MAIL_FROM_ADDRESS=gajerautsav08@gmail.com

# ============================================================
# Service Ports
# ============================================================
AUTH_PORT=8087
GAME_PORT=8082
PURCHASE_PORT=8083
WISHLIST_PORT=8084
NOTIFICATION_PORT=8086
STORAGE_PORT=8085
GATEWAY_PORT=8080

# ============================================================
# Service URLs (for inter-service communication)
# ============================================================
AUTH_USER_SERVICE_URL=http://localhost:8087
GAME_SERVICE_URL=http://localhost:8082
PURCHASE_SERVICE_URL=http://localhost:8083
WISHLIST_SERVICE_URL=http://localhost:8084
NOTIFICATION_SERVICE_URL=http://localhost:8086
STORAGE_SERVICE_URL=http://localhost:8085

# ============================================================
# OpenSearch (Optional - for game search)
# ============================================================
OPENSEARCH_ENABLED=true
OPENSEARCH_HOST=gamespotlightsearchgames-gajerautsav08-9ccc.i.aivencloud.com
OPENSEARCH_PORT=22498
OPENSEARCH_SCHEME=https
OPENSEARCH_USERNAME=avnadmin
OPENSEARCH_PASSWORD=CHANGE_ME_OPENSEARCH_PASSWORD
OPENSEARCH_INDEX=games
OPENSEARCH_SYNC_ENABLED=true
OPENSEARCH_REBUILD_ON_STARTUP=false
OPENSEARCH_BACKFILL_ON_STARTUP=false

# ============================================================
# Application Configuration
# ============================================================
SPRING_PROFILES_ACTIVE=prod
LOGGING_LEVEL_ROOT=INFO
LOGGING_LEVEL_COM_GAMESTORE=INFO

# ============================================================
# Spring Security (CORS for frontend)
# ============================================================
ALLOWED_ORIGINS=https://yourdomain.com,https://game-spot-light.vercel.app/

# ============================================================
# Flyway Database Migration
# ============================================================
SPRING_FLYWAY_ENABLED=false
SPRING_JPA_HIBERNATE_DDL_AUTO=none
SPRING_JPA_HIBERNATE_DIALECT=org.hibernate.dialect.PostgreSQL10Dialect

# ============================================================
# Connection Pooling
# ============================================================
SPRING_DATASOURCE_HIKARI_MAXIMUM_POOL_SIZE=10
SPRING_DATASOURCE_HIKARI_MINIMUM_IDLE=5
SPRING_DATASOURCE_HIKARI_CONNECTION_TIMEOUT=20000
SPRING_DATASOURCE_HIKARI_IDLE_TIMEOUT=300000
SPRING_DATASOURCE_HIKARI_MAX_LIFETIME=1200000
